# Виртуальное окружение
.venv/
venv/
ENV/
env/

# Python кэш и временные файлы
__pycache__/
*.py[cod]
*$py.class
*.so

# Локальная база данных SQLite (на Render будет использовать PostgreSQL)
*.sqlite3
*.sqlite3-journal

# Медиа-файлы и статика, загружаемые локально
media/
staticfiles/

# Переменные окружения и секреты
.env
.env.*

# Настройки IDE и редакторов
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Файлы логов
*.log